# Copie para .env.local e ajuste. Nunca comitar .env.local (já ignorado).

# Modo demonstração: usa um banco separado (ou a semente em memória, se
# as variáveis do Supabase abaixo não estiverem definidas) e exibe a
# faixa "DEMONSTRAÇÃO, dados fictícios" no topo do app.
DEMO_MODE=true

# Supabase (produção ou projeto de demonstração separado). Deixe em
# branco para rodar só com a semente de demonstração em memória.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Segredo usado para assinar os cookies de sessão (JWT via jose).
# Gere algo como: openssl rand -base64 48
SESSION_SECRET=troque-este-valor-em-produção

# Chave de criptografia dos dados pessoais (CPF/RG), fora do banco.
# Gere algo como: openssl rand -base64 32
PERSONAL_DATA_ENCRYPTION_KEY=troque-este-valor-em-produção

# Segredo do HMAC do QR pessoal (muda a cada 30 s).
QR_SECRET=troque-este-valor-em-produção

# Módulos que podem ser desligados (seção 10: alimentação ainda é proposta).
FEATURE_MEALS=true
# Rádios: exigir digitação de CPF/RG a cada retirada em vez de só conferir (seção 9).
RADIO_REQUIRE_TYPED_DOCS=false
# Dias após o evento para apagar CPF, RG e assinaturas (seção 12).
RETENTION_DAYS_AFTER_EVENT=30
